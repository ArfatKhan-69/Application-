        });
        tabBtn.className = "sidebar-tab active px-3.5 py-2 text-xs font-semibold rounded-t-xl border-b-2 border-indigo-500 text-white bg-slate-800/60 flex items-center gap-1.5 transition";

        const target = tabBtn.getAttribute("data-tab");
        document.getElementById("tabPanelTranscript").classList.toggle("hidden", target !== "transcript");
