    /********************************************************************
     * 7. SCENARIO SWITCHING, REPORT CARD, & EVENT LISTENERS
     ********************************************************************/
    function initOrResetScenario(modeKey) {
      stopAllSpeech();
      if (state.isRecording) stopListeningAndSend();

      state.currentMode = modeKey;
      const modeConfig = SCENARIO_MODES[modeKey] || SCENARIO_MODES.free_talk;

      const greeting =
        modeKey === "custom" && state.customTopicText
          ? `Awesome! Let's talk about "${state.customTopicText}". How would you like to start, or what's your favorite aspect of this topic?`
          : modeConfig.starterGreeting;

      state.lastNovaReply = greeting;
      state.currentHint = modeConfig.starterHint;
      state.geminiChatHistory = [
        {
          role: "model",
          parts: [{ text: greeting }]
        }
      ];

      state.messages = [
        {
          id: "msg_init_" + Date.now(),
          sender: "nova",
          text: greeting,
          timestamp: new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })
        }
      ];

      document.getElementById("novaLiveSubtitle").textContent = `"${greeting}"`;
      document.getElementById("hintText").textContent = `"${state.currentHint}"`;
      renderTranscriptFeed();
      speakNovaText(greeting, false);
