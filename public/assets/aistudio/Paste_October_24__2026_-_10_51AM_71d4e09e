        return;
      }
      if (state.isRecording) {
        stopListeningAndSend();
      } else {
        startListening();
      }
    }

    document.getElementById("btnMicToggle").addEventListener("click", handlePrimaryMicAction);
    document.getElementById("orbClickArea").addEventListener("click", handlePrimaryMicAction);

    // Interrupt or Replay Button
    document.getElementById("btnInterruptOrReplay").addEventListener("click", () => {
