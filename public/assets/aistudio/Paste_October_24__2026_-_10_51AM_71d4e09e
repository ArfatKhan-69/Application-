    // Report Card Modal Logic
    function populateAndShowReportCard() {
      stopAllSpeech();
      document.getElementById("reportTurnsCount").textContent = state.turnsCount;
      document.getElementById("reportWordsCount").textContent = state.totalWordsSpoken;
      document.getElementById("reportFillersCount").textContent = state.totalFillersCount;

      const avg = state.fluencyScores.length > 0
        ? Math.round(state.fluencyScores.reduce((a, b) => a + b, 0) / state.fluencyScores.length)
        : 0;
      document.getElementById("reportAvgFluency").textContent = state.fluencyScores.length > 0 ? `${avg}%` : "--%";

      const fillerSummaryEl = document.getElementById("reportFillerSummary");
      if (state.turnsCount === 0) {
        fillerSummaryEl.textContent = "Complete a few speaking turns with Nova to unlock your filler word & pacing insights.";
      } else if (state.totalFillersCount === 0) {
        fillerSummaryEl.innerHTML = `<span class="text-emerald-400 font-semibold">Spotless delivery!</span> You spoke ${state.totalWordsSpoken} words across ${state.turnsCount} turns without relying on filler words like "um", "uh", or "basically".`;
      } else {
        const pairs = Object.entries(state.fillerBreakdown)
          .map(([word, count]) => `"${word}" (${count}x)`)
          .join(", ");
        fillerSummaryEl.innerHTML = `We detected <span class="text-rose-300 font-semibold">${state.totalFillersCount} filler word(s)</span> during your session: <span class="text-white font-mono">${pairs}</span>. Tip: Try pausing silently for half a second instead of using filler words to sound more executive and confident.`;
      }

      const corrListEl = document.getElementById("reportCorrectionsList");
      if (state.corrections.length === 0) {
        corrListEl.innerHTML = `<p class="text-xs text-slate-400 italic">No grammar corrections recorded in this session yet. Keep talking with Nova!</p>`;
      } else {
        corrListEl.innerHTML = state.corrections
          .map(
            c => `
          <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-3 text-xs space-y-1">
            <p class="text-rose-300 line-through">"${escapeHtml(c.originalText)}"</p>
            <p class="text-emerald-300 font-semibold"><i class="fa-solid fa-arrow-right mr-1"></i>"${escapeHtml(c.correctedText)}"</p>
            <p class="text-[11px] text-slate-400">${escapeHtml(c.explanation)}</p>
          </div>
        `
          )
          .join("");
      }

      document.getElementById("modalReportCard").classList.remove("hidden");
    }

    document.getElementById("btnOpenReport").addEventListener("click", populateAndShowReportCard);
    document.getElementById("btnCloseReport").addEventListener("click", () => {
      document.getElementById("modalReportCard").classList.add("hidden");
    });
    document.getElementById("btnContinueCall").addEventListener("click", () => {
      document.getElementById("modalReportCard").classList.add("hidden");
    });

    // Copy Report Summary to Clipboard
    document.getElementById("btnCopyReport").addEventListener("click", () => {
      const avg = state.fluencyScores.length > 0
        ? Math.round(state.fluencyScores.reduce((a, b) => a + b, 0) / state.fluencyScores.length)
        : 0;
      const lines = [
        "=== NovaSpeak AI Spoken English Report Card ===",
        `Practice Mode: ${SCENARIO_MODES[state.currentMode]?.name || "Free Talk"}`,
        `Speaking Turns: ${state.turnsCount} | Words Spoken: ${state.totalWordsSpoken}`,
        `Average Fluency Score: ${avg}% | Filler Words: ${state.totalFillersCount}`,
        "",
        "Top Phrasing Upgrades:"
      ];
      state.corrections.forEach((c, idx) => {
        lines.push(`${idx + 1}. Instead of: "${c.originalText}" -> Say: "${c.correctedText}" (${c.explanation})`);
      });

      const tempInput = document.createElement("textarea");
      tempInput.value = lines.join("\n");
      document.body.appendChild(tempInput);
      tempInput.select();
      document.execCommand("copy");
      document.body.removeChild(tempInput);

      showToast("Session Report copied to clipboard!");
    });

    // Live Call Timer
    setInterval(() => {
      const elapsedSec = Math.floor((Date.now() - state.sessionStartTime) / 1000);
      const mins = String(Math.floor(elapsedSec / 60)).padStart(2, "0");
      const secs = String(elapsedSec % 60)).padStart(2, "0");
      document.getElementById("statTimer").textContent = `${mins}:${secs}`;
    }, 1000);

    // Initialize Application on Load
    window.onload = function () {
      resizeOrbCanvas();
      animateNovaOrb();
      renderSavedDeck();

      // Seed initial greeting message in transcript
      state.messages.push({
        id: "msg_welcome",
        sender: "nova",
        text: SCENARIO_MODES.free_talk.starterGreeting,
        timestamp: new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })
      });
      state.geminiChatHistory.push({
        role: "model",
        parts: [{ text: SCENARIO_MODES.free_talk.starterGreeting }]
      });
      renderTranscriptFeed();
    };
  </script>
