    window.saveToDeck = function (original, better, tip) {
      const exists = state.savedDeck.some(item => item.better === better);
      if (exists) {
        showToast("Already in your Saved Phrase Deck!");
        return;
      }
      state.savedDeck.unshift({ original, better, tip, savedAt: Date.now() });
      try {
        localStorage.setItem("novaspeak_saved_deck_v1", JSON.stringify(state.savedDeck));
      } catch (e) {}
      renderSavedDeck();
      updateHeaderAnalyticsUI();
      showToast("Saved to your Phrase Deck!");
