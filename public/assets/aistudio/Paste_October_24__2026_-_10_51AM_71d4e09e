  <!-- APPLICATION SCRIPT -->
  <script>
    /********************************************************************
     * 1. STATE & CONFIGURATION
     ********************************************************************/
    const apiKey = ""; // Canvas runtime injects API key automatically

    const SCENARIO_MODES = {
      free_talk: {
        name: "Free Talk",
        systemContext: "Casual, friendly phone call about everyday life, hobbies, movies, technology, or personal goals.",
        starterGreeting: "Hey there! I'm Nova, your personal English speaking partner. Tap the microphone below and tell me—how is your day going so far?",
        starterHint: "My day has been pretty good so far! I spent the morning catching up on my work, and now I'm excited to practice my English."
      },
      job_interview: {
        name: "Job & HR Interview Coach",
        systemContext: "Friendly but professional HR/Hiring Manager conducting a mock job interview. Ask realistic behavioral and career questions and help the user sound confident and articulate.",
        starterGreeting: "Welcome! Let's practice for your upcoming job interview. To kick things off, could you tell me a little bit about yourself and what kind of role you're aiming for?",
        starterHint: "Sure! I'm a software developer with a strong passion for building user-focused applications, and I'm currently looking for a full-stack role."
      },
      situational: {
        name: "Everyday Situational Roleplay",
        systemContext: "Everyday real-world English situations such as networking at a conference, ordering at a specialty cafe, workplace meetings, or international travel.",
        starterGreeting: "Let's do a quick real-world roleplay! Imagine we just bumped into each other at an international tech & creator networking mixer. What brings you to the event today?",
        starterHint: "Hi! It's great to meet you. I came here today to meet fellow builders and learn more about the latest trends in AI."
      },
      debate: {
        name: "Debate & Opinion Express",
        systemContext: "Intellectual yet friendly debate partner helping the user structure persuasive arguments, use transition words, and defend viewpoints clearly in English.",
        starterGreeting: "Let's sharpen your persuasive English! Here's a fun topic: Do you think remote work is better than working from an office, or does in-person collaboration still win? What's your take?",
        starterHint: "In my opinion, a hybrid model works best because remote work offers deep focus, while office days help build team culture."
      },
      custom: {
        name: "Custom Topic",
        systemContext: "Custom user-selected conversation topic.",
        starterGreeting: "I'm ready! Type your custom topic or scenario above, or just start speaking about whatever is on your mind right now.",
        starterHint: "I'd love to practice talking about my favorite book and why it inspired me."
      }
    };

    const FILLER_WORDS_LIST = ["um", "uh", "er", "ah", "like", "basically", "actually", "literally", "you know", "sort of", "kind of"];

    const state = {
      orbState: "idle", // 'idle' | 'listening' | 'thinking' | 'speaking'
      currentMode: "free_talk",
      customTopicText: "",
      handsFreeMode: true,
      autoSpeak: true,
      ttsEngine: "browser", // 'browser' | 'gemini'
      speechRate: 1.0,
      selectedVoiceURI: "",
      isRecording: false,
      isProcessingLLM: false,
      isSpeaking: false,
      lastNovaReply: SCENARIO_MODES.free_talk.starterGreeting,
      currentHint: SCENARIO_MODES.free_talk.starterHint,

      // Session Stats
      sessionStartTime: Date.now(),
      turnsCount: 0,
      fluencyScores: [],
      totalWordsSpoken: 0,
      totalFillersCount: 0,
      fillerBreakdown: {},

      // Conversation & Coaching Data
      messages: [], // { id, sender: 'nova'|'user', text, timestamp, coaching?: {...} }
      corrections: [],
      savedDeck: [],
      geminiChatHistory: []
    };

    // Load saved deck from localStorage
    try {
      const savedRaw = localStorage.getItem("novaspeak_saved_deck_v1");
      if (savedRaw) state.savedDeck = JSON.parse(savedRaw);
    } catch (e) {
      console.warn("Could not load saved phrases from storage:", e);
    }

    /********************************************************************
     * 2. INTERACTIVE 60FPS VOICE ORB CANVAS VISUALIZER
     ********************************************************************/
    const orbCanvas = document.getElementById("novaOrbCanvas");
    const orbCtx = orbCanvas.getContext("2d");
    let orbPhase = 0;

    function resizeOrbCanvas() {
      const rect = orbCanvas.parentElement.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      orbCanvas.width = rect.width * dpr;
      orbCanvas.height = rect.height * dpr;
      orbCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    window.addEventListener("resize", resizeOrbCanvas);

    function setOrbVisualState(newState) {
      state.orbState = newState;
      const backdrop = document.getElementById("orbBackdrop");
      const dot = document.getElementById("orbStateDot");
      const label = document.getElementById("orbStateLabel");
      const micBtn = document.getElementById("btnMicToggle");
      const micIcon = document.getElementById("micBtnIcon");
      const micLabel = document.getElementById("micBtnLabel");
      const interruptIcon = document.getElementById("interruptIcon");
      const interruptLabel = document.getElementById("interruptLabel");

      backdrop.className = "absolute w-72 h-72 sm:w-96 sm:h-96 rounded-full transition-all duration-700 pointer-events-none ";

      if (newState === "listening") {
        backdrop.classList.add("orb-backdrop-listening");
        dot.className = "w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping";
        label.textContent = "Listening to you... Speak naturally";
        label.className = "text-xs font-semibold tracking-wide text-emerald-300 uppercase";

        micBtn.className = "relative group flex items-center justify-center gap-2.5 px-7 py-4 rounded-full font-display font-bold text-sm sm:text-base text-white bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 shadow-xl shadow-emerald-500/30 transition-all transform active:scale-95 ring-4 ring-emerald-500/20";
        micIcon.className = "fa-solid fa-stop text-lg animate-pulse";
        micLabel.textContent = "Done Speaking";
      } else if (newState === "thinking") {
        backdrop.classList.add("orb-backdrop-thinking");
        dot.className = "w-2.5 h-2.5 rounded-full bg-fuchsia-400 animate-ping";
        label.textContent = "Nova is crafting a response...";
        label.className = "text-xs font-semibold tracking-wide text-fuchsia-300 uppercase";

        micBtn.className = "relative group flex items-center justify-center gap-2.5 px-7 py-4 rounded-full font-display font-bold text-sm sm:text-base text-slate-300 bg-slate-800 border border-slate-700 cursor-wait";
        micIcon.className = "fa-solid fa-circle-notch fa-spin text-lg text-fuchsia-400";
        micLabel.textContent = "Thinking...";
      } else if (newState === "speaking") {
        backdrop.classList.add("orb-backdrop-speaking");
        dot.className = "w-2.5 h-2.5 rounded-full bg-cyan-400 animate-ping";
        label.textContent = "Nova is Speaking • Tap Orb to Interrupt";
        label.className = "text-xs font-semibold tracking-wide text-cyan-300 uppercase";

        micBtn.className = "relative group flex items-center justify-center gap-2.5 px-7 py-4 rounded-full font-display font-bold text-sm sm:text-base text-white bg-gradient-to-r from-indigo-600 via-violet-600 to-indigo-600 hover:from-indigo-500 hover:to-violet-500 shadow-xl shadow-indigo-600/30 transition-all";
        micIcon.className = "fa-solid fa-hand text-lg";
        micLabel.textContent = "Interrupt & Speak";

        interruptIcon.className = "fa-solid fa-volume-xmark text-rose-400";
        interruptLabel.textContent = "Stop Voice";
      } else {
        backdrop.classList.add("orb-backdrop-idle");
        dot.className = "w-2 h-2 rounded-full bg-indigo-400";
        label.textContent = "Nova • Ready to Talk";
        label.className = "text-xs font-semibold tracking-wide text-indigo-200 uppercase";

        micBtn.className = "relative group flex items-center justify-center gap-2.5 px-7 py-4 rounded-full font-display font-bold text-sm sm:text-base text-white bg-gradient-to-r from-indigo-600 via-violet-600 to-indigo-600 hover:from-indigo-500 hover:to-violet-500 shadow-xl shadow-indigo-600/30 transition-all transform active:scale-95";
        micIcon.className = "fa-solid fa-microphone text-lg";
        micLabel.textContent = "Tap to Speak";

        interruptIcon.className = "fa-solid fa-rotate-left";
        interruptLabel.textContent = "Replay Voice";
      }
    }

    function animateNovaOrb() {
      const rect = orbCanvas.parentElement.getBoundingClientRect();
      const width = rect.width;
      const height = rect.height;
      const cx = width / 2;
      const cy = height / 2;
      const baseRadius = Math.min(width, height) * 0.31;

      orbCtx.clearRect(0, 0, width, height);

      // Speed & amplitude based on state
      let speed = 0.03;
      let waveAmp = 4;
      let colorPrimary = "rgba(99, 102, 241, 0.85)";
      let colorSecondary = "rgba(56, 189, 248, 0.55)";
      let coreGradStart = "#818cf8";
      let coreGradEnd = "#312e81";

      if (state.orbState === "listening") {
        speed = 0.08;
        waveAmp = 12;
        colorPrimary = "rgba(16, 185, 129, 0.85)";
        colorSecondary = "rgba(6, 182, 212, 0.65)";
        coreGradStart = "#34d399";
        coreGradEnd = "#065f46";
      } else if (state.orbState === "thinking") {
        speed = 0.11;
        waveAmp = 9;
        colorPrimary = "rgba(217, 70, 239, 0.85)";
        colorSecondary = "rgba(139, 92, 246, 0.65)";
        coreGradStart = "#e879f9";
        coreGradEnd = "#4c1d95";
      } else if (state.orbState === "speaking") {
        speed = 0.095;
        waveAmp = 16;
        colorPrimary = "rgba(56, 189, 248, 0.9)";
        colorSecondary = "rgba(129, 140, 248, 0.7)";
        coreGradStart = "#38bdf8";
        coreGradEnd = "#3730a3";
      }

      orbPhase += speed;

      // Draw 3 harmonic organic wave layers
      for (let layer = 0; layer < 3; layer++) {
        orbCtx.beginPath();
        const layerOffset = layer * 1.3;
        const radiusScale = 1 + layer * 0.11;

        for (let angle = 0; angle <= Math.PI * 2; angle += 0.06) {
          const harmonic =
            Math.sin(angle * 4 + orbPhase + layerOffset) * waveAmp * 0.6 +
            Math.cos(angle * 3 - orbPhase * 1.2 + layer) * waveAmp * 0.4;
          const r = baseRadius * radiusScale + harmonic;
          const x = cx + Math.cos(angle) * r;
          const y = cy + Math.sin(angle) * r;
          if (angle === 0) orbCtx.moveTo(x, y);
          else orbCtx.lineTo(x, y);
        }
        orbCtx.closePath();
        orbCtx.strokeStyle = layer % 2 === 0 ? colorPrimary : colorSecondary;
        orbCtx.lineWidth = 2.2 - layer * 0.4;
        orbCtx.stroke();

        orbCtx.fillStyle = layer === 0 ? colorPrimary.replace("0.85", "0.14") : "transparent";
        orbCtx.fill();
      }

      // Draw Glowing Inner Core Sphere
      const coreGrad = orbCtx.createRadialGradient(
        cx - baseRadius * 0.25,
        cy - baseRadius * 0.25,
        baseRadius * 0.1,
        cx,
        cy,
        baseRadius * 0.95
      );
      coreGrad.addColorStop(0, coreGradStart);
      coreGrad.addColorStop(0.65, colorPrimary);
      coreGrad.addColorStop(1, coreGradEnd);

      orbCtx.beginPath();
      const pulseCore = baseRadius * (0.88 + Math.sin(orbPhase * 1.4) * 0.04);
      orbCtx.arc(cx, cy, pulseCore, 0, Math.PI * 2);
      orbCtx.fillStyle = coreGrad;
      orbCtx.fill();

      requestAnimationFrame(animateNovaOrb);
    }

    /********************************************************************
     * 3. SPEECH SYNTHESIS (BROWSER NEURAL + GEMINI 2.5 TTS SUPPORT)
     ********************************************************************/
    let availableVoices = [];
    let currentAudioElement = null;

    function populateVoiceList() {
      if (!("speechSynthesis" in window)) return;
      availableVoices = window.speechSynthesis.getVoices();
      const englishVoices = availableVoices.filter(v => v.lang && v.lang.toLowerCase().startsWith("en"));
      const voicesToShow = englishVoices.length > 0 ? englishVoices : availableVoices;

      const selectEl = document.getElementById("selectVoiceList");
      if (voicesToShow.length === 0) return;

      selectEl.innerHTML = "";

      // Prioritize natural female/assistant voices like Google US English, Samantha, Aria, Sonia, Natasha
      let preferredVoice = voicesToShow.find(v =>
        /Google US English|Microsoft Aria|Microsoft Jenny|Samantha|Victoria|Karen|Sonia|Natural/i.test(v.name)
      ) || voicesToShow[0];

      if (!state.selectedVoiceURI && preferredVoice) {
        state.selectedVoiceURI = preferredVoice.voiceURI;
      }

      voicesToShow.forEach(voice => {
        const opt = document.createElement("option");
        opt.value = voice.voiceURI;
        opt.textContent = `${voice.name} (${voice.lang})`;
        if (voice.voiceURI === state.selectedVoiceURI) opt.selected = true;
        selectEl.appendChild(opt);
      });
    }

    if ("speechSynthesis" in window) {
      populateVoiceList();
      window.speechSynthesis.onvoiceschanged = populateVoiceList;
    }

    function stopAllSpeech() {
      if ("speechSynthesis" in window) {
        window.speechSynthesis.cancel();
      }
      if (currentAudioElement) {
        currentAudioElement.pause();
        currentAudioElement = null;
      }
      state.isSpeaking = false;
      if (!state.isRecording && !state.isProcessingLLM) {
        setOrbVisualState("idle");
      }
    }

    // Helper for Gemini TTS PCM16 to WAV
    function base64ToArrayBuffer(base64) {
      const binaryString = window.atob(base64);
      const len = binaryString.length;
      const bytes = new Uint8Array(len);
      for (let i = 0; i < len; i++) {
        bytes[i] = binaryString.charCodeAt(i);
      }
      return bytes.buffer;
    }

    function pcmToWav(pcm16, sampleRate = 24000) {
      const buffer = new ArrayBuffer(44 + pcm16.length * 2);
      const view = new DataView(buffer);
      const writeString = (offset, str) => {
        for (let i = 0; i < str.length; i++) view.setUint8(offset + i, str.charCodeAt(i));
      };
      writeString(0, "RIFF");
      view.setUint32(4, 36 + pcm16.length * 2, true);
      writeString(8, "WAVE");
      writeString(12, "fmt ");
      view.setUint32(16, 16, true);
      view.setUint16(20, 1, true);
      view.setUint16(22, 1, true);
      view.setUint32(24, sampleRate, true);
      view.setUint32(28, sampleRate * 2, true);
      view.setUint16(32, 2, true);
      view.setUint16(34, 16, true);
      writeString(36, "data");
      view.setUint32(40, pcm16.length * 2, true);
      for (let i = 0; i < pcm16.length; i++) {
        view.setInt16(44 + i * 2, pcm16[i], true);
      }
      return new Blob([buffer], { type: "audio/wav" });
    }

    async function speakWithGeminiTTS(text, onFinishedCallback) {
      try {
        setOrbVisualState("speaking");
        state.isSpeaking = true;

        const payload = {
          contents: [{ parts: [{ text: `Say in a warm, natural, friendly conversational tone: ${text}` }] }],
          generationConfig: {
            responseModalities: ["AUDIO"],
            speechConfig: {
              voiceConfig: {
                prebuiltVoiceConfig: { voiceName: "Aoede" }
              }
            }
          }
        };

        const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-tts:generateContent?key=${apiKey}`;
        const res = await fetch(url, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        const part = data?.candidates?.[0]?.content?.parts?.[0];
        const audioBase64 = part?.inlineData?.data;
        const mimeType = part?.inlineData?.mimeType || "audio/L16;rate=24000";

        if (audioBase64) {
          const rateMatch = mimeType.match(/rate=(\d+)/);
          const sampleRate = rateMatch ? parseInt(rateMatch[1], 10) : 24000;
          const pcmBuffer = base64ToArrayBuffer(audioBase64);
          const pcm16 = new Int16Array(pcmBuffer);
          const wavBlob = pcmToWav(pcm16, sampleRate);
          const audioUrl = URL.createObjectURL(wavBlob);

          currentAudioElement = new Audio(audioUrl);
          currentAudioElement.playbackRate = state.speechRate;
          currentAudioElement.onended = () => {
            state.isSpeaking = false;
            setOrbVisualState("idle");
            if (onFinishedCallback) onFinishedCallback();
          };
          currentAudioElement.onerror = () => {
            state.isSpeaking = false;
            setOrbVisualState("idle");
            if (onFinishedCallback) onFinishedCallback();
          };
          await currentAudioElement.play();
          return;
        }
      } catch (e) {
        // Fallback to browser TTS if Gemini TTS fails
      }
      speakWithBrowserTTS(text, onFinishedCallback);
    }

    function speakWithBrowserTTS(text, onFinishedCallback) {
      if (!("speechSynthesis" in window)) {
        if (onFinishedCallback) onFinishedCallback();
        return;
      }

      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.rate = state.speechRate;
      utterance.pitch = 1.03;

      if (availableVoices.length === 0) {
        availableVoices = window.speechSynthesis.getVoices();
      }
      const chosenVoice = availableVoices.find(v => v.voiceURI === state.selectedVoiceURI);
      if (chosenVoice) utterance.voice = chosenVoice;

      utterance.onstart = () => {
        state.isSpeaking = true;
        setOrbVisualState("speaking");
      };

      utterance.onend = () => {
        state.isSpeaking = false;
        setOrbVisualState("idle");
        if (onFinishedCallback) onFinishedCallback();
      };

      utterance.onerror = () => {
        state.isSpeaking = false;
        setOrbVisualState("idle");
        if (onFinishedCallback) onFinishedCallback();
      };

      window.speechSynthesis.speak(utterance);
    }

    function speakNovaText(text, autoListenAfter = true) {
      if (!state.autoSpeak) {
        setOrbVisualState("idle");
        return;
      }

      const afterSpeech = () => {
        if (autoListenAfter && state.handsFreeMode && !state.isRecording && !state.isProcessingLLM) {
          setTimeout(() => {
            if (!state.isSpeaking && !state.isProcessingLLM) {
              startListening();
            }
          }, 350);
        }
      };

      if (state.ttsEngine === "gemini") {
        speakWithGeminiTTS(text, afterSpeech);
      } else {
        speakWithBrowserTTS(text, afterSpeech);
      }
    }

    /********************************************************************
     * 4. WEB SPEECH API (SPEECH-TO-TEXT RECOGNITION)
     ********************************************************************/
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    let recognition = null;
    let accumulatedTranscript = "";

    if (SpeechRecognition) {
      recognition = new SpeechRecognition();
      recognition.continuous = true;
      recognition.interimResults = true;
      recognition.lang = "en-US";

      recognition.onstart = () => {
        state.isRecording = true;
        setOrbVisualState("listening");
        const box = document.getElementById("interimTranscriptText");
        box.textContent = "Listening... speak now";
        box.classList.remove("hidden");
      };

      recognition.onresult = (event) => {
        let interim = "";
        let finalChunk = "";
        for (let i = event.resultIndex; i < event.results.length; i++) {
          const transcriptPiece = event.results[i][0].transcript;
          if (event.results[i].isFinal) {
            finalChunk += transcriptPiece + " ";
          } else {
            interim += transcriptPiece;
          }
        }
        if (finalChunk) {
          accumulatedTranscript += finalChunk;
        }
        const combinedPreview = (accumulatedTranscript + " " + interim).trim();
        const box = document.getElementById("interimTranscriptText");
        if (combinedPreview) {
          box.textContent = `"${combinedPreview}"`;
          box.classList.remove("hidden");
        }
      };

      recognition.onerror = (event) => {
        if (event.error === "not-allowed") {
          showToast("Microphone permission denied. You can also type below!");
        }
        state.isRecording = false;
        if (!state.isProcessingLLM && !state.isSpeaking) {
          setOrbVisualState("idle");
        }
      };

      recognition.onend = () => {
        const wasRecording = state.isRecording;
        state.isRecording = false;
        const box = document.getElementById("interimTranscriptText");
        box.classList.add("hidden");

        const finalSpoken = accumulatedTranscript.trim();
        accumulatedTranscript = "";

        if (wasRecording && finalSpoken.length > 0) {
          handleUserTurn(finalSpoken);
        } else if (!state.isProcessingLLM && !state.isSpeaking) {
          setOrbVisualState("idle");
        }
      };
    }

    function startListening() {
      if (state.isProcessingLLM) return;
      stopAllSpeech();

      if (!recognition) {
        showToast("Voice recognition isn't supported in this browser. Use the text box below!");
        document.getElementById("textFallbackInput").focus();
        return;
      }

      try {
        accumulatedTranscript = "";
        recognition.start();
      } catch (e) {
        // Already started
      }
    }

    function stopListeningAndSend() {
      if (!recognition || !state.isRecording) return;
      try {
        recognition.stop();
      } catch (e) {}
    }

    /********************************************************************
     * 5. DUAL-CHANNEL GEMINI AI BRAIN (CONVERSATION + GRAMMAR COACH)
     ********************************************************************/
    async function callGeminiWithBackoff(payload, maxRetries = 4) {
      const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;
      let delay = 1000;

      for (let attempt = 0; attempt < maxRetries; attempt++) {
        try {
          const response = await fetch(apiUrl, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
          });

          if (!response.ok) {
            throw new Error(`HTTP status ${response.status}`);
          }

          return await response.json();
        } catch (err) {
          if (attempt === maxRetries - 1) throw err;
          await new Promise(res => setTimeout(res, delay));
          delay *= 2;
        }
      }
    }

    function analyzeFillersAndWords(text) {
      const cleanWords = text.trim().split(/\s+/).filter(Boolean);
      state.totalWordsSpoken += cleanWords.length;

      const lowerText = text.toLowerCase();
      let turnFillers = 0;

      FILLER_WORDS_LIST.forEach(filler => {
        const regex = new RegExp(`\\b${filler}\\b`, "gi");
        const matches = lowerText.match(regex);
        if (matches && matches.length > 0) {
          turnFillers += matches.length;
          state.fillerBreakdown[filler] = (state.fillerBreakdown[filler] || 0) + matches.length;
        }
      });

      state.totalFillersCount += turnFillers;
      return turnFillers;
    }

    async function handleUserTurn(userText) {
      const trimmed = userText.trim();
      if (!trimmed || state.isProcessingLLM) return;

      stopAllSpeech();
      state.isProcessingLLM = true;
      setOrbVisualState("thinking");

      // Update stats
      state.turnsCount += 1;
      const fillersInTurn = analyzeFillersAndWords(trimmed);
      updateHeaderAnalyticsUI();

      // Create initial user message in transcript
      const userMsgId = "msg_" + Date.now();
      const userMsgObj = {
        id: userMsgId,
        sender: "user",
        text: trimmed,
        timestamp: new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" }),
        fillersInTurn,
        coaching: null // populated when Gemini responds
      };
      state.messages.push(userMsgObj);
      renderTranscriptFeed();

      // Build System Prompt based on active mode
      const activeModeInfo = SCENARIO_MODES[state.currentMode] || SCENARIO_MODES.free_talk;
      const scenarioDescription = state.currentMode === "custom" && state.customTopicText
        ? `Custom Topic requested by user: "${state.customTopicText}"`
        : activeModeInfo.systemContext;

      const systemInstructionText = `You are Nova, a warm, encouraging, realistic Spoken English Communication Partner and Fluency Coach (inspired by SuperNova AI).
Current Practice Scenario: ${scenarioDescription}

YOUR RULES:
1. Respond in ` + "`spokenReply`" + ` like a real human friend or coach on a live phone call: keep it concise (2 to 3 sentences maximum), natural, engaging, and ALWAYS end with an open-ended follow-up question to keep the user talking. Do NOT use markdown or bullet points inside ` + "`spokenReply`" + `.
2. Evaluate the user's message for grammar accuracy, natural native English phrasing, and fluency:
   - Set ` + "`hasMistake`" + ` to true if the user made a grammatical error, used awkward phrasing, or if there is a noticeably smoother way a native speaker would say it.
   - Provide ` + "`correctedText`" + `: a polished, natural native-sounding version of the user's exact thought.
   - Provide ` + "`explanation`" + `: a friendly, encouraging 1-sentence coaching tip explaining the grammar fix or phrasing improvement.
   - Provide ` + "`vocabUpgrade`" + `: 1 or 2 relevant higher-level English words, phrasal verbs, or idioms the user can use for this topic.
   - Provide ` + "`fluencyScore`" + `: an integer from 1 to 100 rating the clarity, grammar, and naturalness of the user's turn.
   - Provide ` + "`suggestedReplyHint`" + `: a natural 1-sentence example answer the user could say next in response to your new question.`;

      state.geminiChatHistory.push({
        role: "user",
        parts: [{ text: trimmed }]
      });

      const payload = {
        contents: state.geminiChatHistory,
        systemInstruction: {
          parts: [{ text: systemInstructionText }]
        },
        generationConfig: {
          responseMimeType: "application/json",
          responseSchema: {
            type: "OBJECT",
            properties: {
              spokenReply: { type: "STRING" },
              hasMistake: { type: "BOOLEAN" },
              originalText: { type: "STRING" },
              correctedText: { type: "STRING" },
              explanation: { type: "STRING" },
              vocabUpgrade: {
                type: "ARRAY",
                items: {
                  type: "OBJECT",
                  properties: {
                    wordOrIdiom: { type: "STRING" },
                    meaning: { type: "STRING" }
                  },
                  required: ["wordOrIdiom", "meaning"]
                }
              },
              fluencyScore: { type: "INTEGER" },
              suggestedReplyHint: { type: "STRING" }
            },
            required: [
              "spokenReply",
              "hasMistake",
              "originalText",
              "correctedText",
              "explanation",
              "vocabUpgrade",
              "fluencyScore",
              "suggestedReplyHint"
            ]
          }
        }
      };

      try {
        const result = await callGeminiWithBackoff(payload);
        const rawJsonText = result?.candidates?.[0]?.content?.parts?.[0]?.text;
        const parsed = JSON.parse(rawJsonText);

        // Save model response in history
        state.geminiChatHistory.push({
          role: "model",
          parts: [{ text: parsed.spokenReply }]
        });

        // Attach coaching feedback to user message
        userMsgObj.coaching = {
          hasMistake: parsed.hasMistake,
          originalText: parsed.originalText || trimmed,
          correctedText: parsed.correctedText,
          explanation: parsed.explanation,
          vocabUpgrade: parsed.vocabUpgrade || [],
          fluencyScore: parsed.fluencyScore || 85
        };

        state.fluencyScores.push(userMsgObj.coaching.fluencyScore);

        if (parsed.hasMistake || (parsed.vocabUpgrade && parsed.vocabUpgrade.length > 0)) {
          state.corrections.unshift({
            id: "corr_" + Date.now(),
            ...userMsgObj.coaching,
            timestamp: userMsgObj.timestamp
          });
        }

        // Add Nova's reply message
        const novaReplyText = parsed.spokenReply || "That's really interesting! Could you tell me a bit more about that?";
        state.lastNovaReply = novaReplyText;
        state.currentHint = parsed.suggestedReplyHint || "I'd love to share more details about my experience with that.";

        state.messages.push({
          id: "msg_nova_" + Date.now(),
          sender: "nova",
          text: novaReplyText,
          timestamp: new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })
        });

        // Update UI
        document.getElementById("novaLiveSubtitle").textContent = `"${novaReplyText}"`;
        document.getElementById("hintText").textContent = `"${state.currentHint}"`;
        updateHeaderAnalyticsUI();
        renderTranscriptFeed();
        renderCorrectionsFeed();

        state.isProcessingLLM = false;
        speakNovaText(novaReplyText, true);

      } catch (error) {
        state.isProcessingLLM = false;
        const fallbackReply = "I heard you! Let's keep going—could you elaborate a little more on what you mean?";
        state.lastNovaReply = fallbackReply;
        state.messages.push({
          id: "msg_nova_" + Date.now(),
          sender: "nova",
          text: fallbackReply,
          timestamp: new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })
        });
        document.getElementById("novaLiveSubtitle").textContent = `"${fallbackReply}"`;
        renderTranscriptFeed();
        speakNovaText(fallbackReply, true);
      }
    }

