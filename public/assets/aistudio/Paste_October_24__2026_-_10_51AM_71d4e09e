<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>NovaSpeak AI — Real-Time Spoken English Partner</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter & Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            display: ['Plus Jakarta Sans', 'sans-serif'],
          },
          colors: {
            nova: {
              50: '#f0f4ff',
              100: '#e0e9ff',
              400: '#818cf8',
              500: '#6366f1',
              600: '#4f46e5',
              900: '#1e1b4b',
              950: '#090816'
            }
          }
        }
      }
    }
  </script>

  <style>
    body {
      background-color: #070913;
      color: #f8fafc;
      overflow-x: hidden;
    }

    /* Custom Scrollbars */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: rgba(15, 23, 42, 0.4);
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(99, 102, 241, 0.35);
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(99, 102, 241, 0.6);
    }

    /* Ambient Glows */
    .orb-backdrop-idle {
      background: radial-gradient(circle, rgba(99, 102, 241, 0.22) 0%, rgba(139, 92, 246, 0.08) 45%, transparent 70%);
    }
    .orb-backdrop-listening {
      background: radial-gradient(circle, rgba(16, 185, 129, 0.28) 0%, rgba(6, 182, 212, 0.12) 45%, transparent 70%);
    }
    .orb-backdrop-thinking {
      background: radial-gradient(circle, rgba(217, 70, 239, 0.28) 0%, rgba(139, 92, 246, 0.14) 45%, transparent 70%);
    }
    .orb-backdrop-speaking {
      background: radial-gradient(circle, rgba(56, 189, 248, 0.32) 0%, rgba(99, 102, 241, 0.16) 50%, transparent 72%);
    }

    /* Glassmorphism panels */
    .glass-panel {
      background: rgba(15, 23, 42, 0.68);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(148, 163, 184, 0.12);
    }

    .glass-card {
      background: rgba(30, 41, 59, 0.55);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(148, 163, 184, 0.12);
    }

    @keyframes pulseRing {
      0% { transform: scale(0.95); opacity: 0.7; }
      50% { transform: scale(1.08); opacity: 0.3; }
      100% { transform: scale(0.95); opacity: 0.7; }
    }

    .animate-pulse-ring {
      animation: pulseRing 2.4s infinite ease-in-out;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col font-sans antialiased selection:bg-indigo-500 selection:text-white">

  <!-- TOP NAVIGATION & LIVE ANALYTICS HEADER -->
  <header class="sticky top-0 z-30 glass-panel border-b border-slate-800/80 px-3 sm:px-6 py-2.5">
    <div class="max-w-[1600px] mx-auto flex flex-wrap items-center justify-between gap-3">
      
      <!-- Brand Logo & Status -->
      <div class="flex items-center gap-3">
        <div class="relative flex items-center justify-center w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 via-violet-500 to-cyan-400 shadow-lg shadow-indigo-500/25">
          <i class="fa-solid fa-waveform-lines text-white text-lg"></i>
          <span id="headerStatusDot" class="absolute -bottom-0.5 -right-0.5 w-3 h-3 rounded-full bg-emerald-400 ring-2 ring-slate-950"></span>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="font-display font-bold text-lg sm:text-xl tracking-tight bg-gradient-to-r from-white via-indigo-200 to-cyan-300 bg-clip-text text-transparent">
              NovaSpeak AI
            </h1>
            <span class="text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
              Live Coach
            </span>
          </div>
          <p class="text-xs text-slate-400 hidden sm:block">24/7 Personal Spoken English & Fluency Partner</p>
        </div>
      </div>

      <!-- Live Session Fluency Metrics Bar -->
      <div class="flex items-center gap-2 sm:gap-4 bg-slate-900/90 border border-slate-800/90 rounded-2xl px-3 py-1.5 text-xs">
        <div class="flex items-center gap-1.5 pr-2 sm:pr-3 border-r border-slate-800" title="Session Call Duration">
          <i class="fa-regular fa-clock text-indigo-400"></i>
          <span id="statTimer" class="font-mono font-semibold text-slate-200">00:00</span>
        </div>
        <div class="flex items-center gap-1.5 pr-2 sm:pr-3 border-r border-slate-800" title="Speaking Turns Completed">
          <i class="fa-solid fa-comments text-cyan-400"></i>
          <span class="text-slate-400 hidden md:inline">Turns:</span>
          <span id="statTurns" class="font-semibold text-white">0</span>
        </div>
        <div class="flex items-center gap-1.5 pr-2 sm:pr-3 border-r border-slate-800" title="Average Fluency & Naturalness Score">
          <i class="fa-solid fa-bolt text-amber-400"></i>
          <span class="text-slate-400 hidden md:inline">Fluency:</span>
          <span id="statFluency" class="font-semibold text-emerald-400">--%</span>
        </div>
        <div class="flex items-center gap-1.5" title="Filler Words Detected (um, uh, like, basically, actually)">
          <i class="fa-solid fa-filter-circle-xmark text-rose-400"></i>
          <span class="text-slate-400 hidden md:inline">Fillers:</span>
          <span id="statFillers" class="font-semibold text-rose-300">0</span>
        </div>
      </div>

      <!-- Right Action Buttons -->
      <div class="flex items-center gap-2">
        <button id="btnOpenSettings" class="p-2.5 rounded-xl bg-slate-800/80 hover:bg-slate-700/80 text-slate-300 hover:text-white border border-slate-700/60 transition flex items-center gap-1.5 text-xs font-medium" title="Voice & Audio Settings">
          <i class="fa-solid fa-sliders text-indigo-400"></i>
          <span class="hidden lg:inline">Voice Settings</span>
        </button>

        <button id="btnOpenReport" class="px-3.5 py-2 rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white font-semibold text-xs shadow-lg shadow-indigo-600/25 transition flex items-center gap-1.5">
          <i class="fa-solid fa-chart-pie"></i>
          <span>Report Card</span>
        </button>
      </div>

    </div>
  </header>

  <!-- MAIN WORKSPACE GRID -->
  <main class="flex-1 max-w-[1600px] w-full mx-auto grid grid-cols-1 lg:grid-cols-12 gap-4 p-3 sm:p-5 overflow-hidden">

    <!-- LEFT COLUMN: SCENARIO SELECTOR, LIVE VOICE ORB, & CALL CONTROLS (7 Cols on Desktop) -->
    <section class="lg:col-span-7 flex flex-col justify-between glass-panel rounded-3xl p-4 sm:p-6 relative overflow-hidden min-h-[580px]">
      
      <!-- Top Bar: Scenario Mode Selector & Continuous Call Switch -->
      <div class="z-10 flex flex-col gap-3">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Practice Mode:</span>
          </div>

          <!-- Continuous Hands-Free Call Toggle -->
          <label class="flex items-center gap-2.5 cursor-pointer bg-slate-900/90 border border-slate-700/80 px-3 py-1.5 rounded-full hover:border-indigo-500/60 transition">
            <input type="checkbox" id="toggleHandsFree" class="sr-only peer" checked>
            <div class="w-8 h-4 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-3 after:w-3 after:transition-all relative peer-checked:bg-emerald-500"></div>
            <span class="text-xs font-medium text-slate-200 flex items-center gap-1.5">
              <i class="fa-solid fa-phone-volume text-emerald-400 text-[11px]"></i>
              Continuous Call Mode
            </span>
          </label>
        </div>

        <!-- Mode Pills -->
        <div id="modeButtonsContainer" class="flex items-center gap-2 overflow-x-auto pb-1 no-scrollbar">
          <button data-mode="free_talk" class="mode-btn active shrink-0 px-3.5 py-2 rounded-xl text-xs font-semibold transition flex items-center gap-2 bg-indigo-600 text-white shadow-md shadow-indigo-600/30 border border-indigo-400/40">
            <i class="fa-solid fa-mug-hot"></i> Free Talk
          </button>
          <button data-mode="job_interview" class="mode-btn shrink-0 px-3.5 py-2 rounded-xl text-xs font-semibold transition flex items-center gap-2 bg-slate-800/80 hover:bg-slate-800 text-slate-300 border border-slate-700/70">
            <i class="fa-solid fa-briefcase"></i> Job Interview
          </button>
          <button data-mode="situational" class="mode-btn shrink-0 px-3.5 py-2 rounded-xl text-xs font-semibold transition flex items-center gap-2 bg-slate-800/80 hover:bg-slate-800 text-slate-300 border border-slate-700/70">
            <i class="fa-solid fa-plane-departure"></i> Everyday Roleplay
          </button>
          <button data-mode="debate" class="mode-btn shrink-0 px-3.5 py-2 rounded-xl text-xs font-semibold transition flex items-center gap-2 bg-slate-800/80 hover:bg-slate-800 text-slate-300 border border-slate-700/70">
            <i class="fa-solid fa-scale-balanced"></i> Debate & Opinion
          </button>
          <button data-mode="custom" class="mode-btn shrink-0 px-3.5 py-2 rounded-xl text-xs font-semibold transition flex items-center gap-2 bg-slate-800/80 hover:bg-slate-800 text-slate-300 border border-slate-700/70">
            <i class="fa-solid fa-wand-magic-sparkles"></i> Custom Topic
          </button>
        </div>

        <!-- Custom Topic Input Bar (Hidden unless Custom Topic selected) -->
        <div id="customTopicWrapper" class="hidden flex items-center gap-2 bg-slate-900/90 p-2 rounded-xl border border-indigo-500/40">
          <input id="customTopicInput" type="text" placeholder="E.g., Pitching my startup idea, talking about Marvel movies, ordering at a restaurant..." class="flex-1 bg-transparent text-xs text-white placeholder-slate-400 focus:outline-none px-2" />
          <button id="btnApplyCustomTopic" class="px-3 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-xs font-semibold text-white transition">
            Start Topic
          </button>
        </div>
      </div>

      <!-- CENTER: NOVA ANIMATED VOICE ORB & LIVE SUBTITLES -->
      <div class="relative flex-1 flex flex-col items-center justify-center my-2 py-4 select-none">
        
        <!-- Dynamic Radial Glow Backdrop -->
        <div id="orbBackdrop" class="orb-backdrop-idle absolute w-72 h-72 sm:w-96 sm:h-96 rounded-full transition-all duration-700 pointer-events-none"></div>

        <!-- State Badge Above Orb -->
        <div class="z-10 mb-3 flex items-center gap-2 px-3.5 py-1 rounded-full bg-slate-900/90 border border-slate-700/80 shadow-inner">
          <span id="orbStateDot" class="w-2 h-2 rounded-full bg-indigo-400 animate-ping"></span>
          <span id="orbStateLabel" class="text-xs font-semibold tracking-wide text-indigo-200 uppercase">Nova • Ready to Talk</span>
        </div>

        <!-- Interactive 60FPS HTML5 Canvas Orb -->
        <div class="relative flex items-center justify-center w-52 h-52 sm:w-64 sm:h-64 cursor-pointer group" id="orbClickArea" title="Click to talk or interrupt Nova">
          <canvas id="novaOrbCanvas" class="w-full h-full z-10"></canvas>
          <div class="absolute inset-4 rounded-full border border-indigo-500/20 group-hover:border-indigo-400/50 transition-all duration-300 pointer-events-none animate-pulse-ring"></div>
        </div>

        <!-- Nova's Current Spoken Subtitle Display -->
        <div class="z-10 max-w-xl w-full text-center mt-3 px-3">
          <p id="novaLiveSubtitle" class="text-sm sm:text-base font-medium text-slate-100 leading-relaxed bg-slate-900/75 border border-slate-800/90 rounded-2xl px-4 py-3 shadow-lg backdrop-blur-md">
            "Hey there! I'm Nova, your personal English speaking partner. Tap the microphone below and tell me—how is your day going so far?"
          </p>
        </div>

        <!-- Live User Speech Interim Transcript Preview -->
        <div id="interimTranscriptBox" class="z-10 mt-2.5 min-h-[28px] flex items-center justify-center">
          <span id="interimTranscriptText" class="text-xs sm:text-sm italic text-emerald-300 bg-emerald-950/60 border border-emerald-500/30 px-3 py-1 rounded-full hidden">
            Listening...
          </span>
        </div>

        <!-- Collapsible Hint Box (When user clicks "Need a Hint") -->
        <div id="hintBanner" class="hidden z-10 mt-2 max-w-lg w-full bg-amber-500/10 border border-amber-500/30 rounded-xl px-3.5 py-2 text-xs text-amber-200 flex items-start justify-between gap-2">
          <div>
            <span class="font-bold text-amber-400"><i class="fa-regular fa-lightbulb mr-1"></i>Try saying:</span>
            <span id="hintText" class="italic">"My day has been pretty productive so far! I spent the morning working on a project, and now I'm excited to practice my English with you."</span>
          </div>
          <button id="btnCloseHint" class="text-amber-300 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
        </div>

      </div>

      <!-- BOTTOM: CALL CONTROLS & TEXT FALLBACK BAR -->
      <div class="z-10 flex flex-col gap-3 pt-2 border-t border-slate-800/80">
        
        <!-- Primary Voice Controls Row -->
        <div class="flex items-center justify-center gap-3 sm:gap-5">
          
          <!-- Need a Hint Button -->
          <button id="btnShowHint" class="px-3.5 py-2.5 rounded-2xl bg-slate-800/90 hover:bg-slate-700/90 text-amber-300 border border-slate-700/80 text-xs font-semibold transition flex items-center gap-1.5 shadow" title="Stuck? Get a starter sentence idea">
            <i class="fa-regular fa-lightbulb"></i>
            <span class="hidden sm:inline">Idea / Hint</span>
          </button>

          <!-- Main Microphone Button (Tap to Speak / Stop & Send) -->
          <button id="btnMicToggle" class="relative group flex items-center justify-center gap-2.5 px-7 py-4 rounded-full font-display font-bold text-sm sm:text-base text-white bg-gradient-to-r from-indigo-600 via-violet-600 to-indigo-600 hover:from-indigo-500 hover:to-violet-500 shadow-xl shadow-indigo-600/30 transition-all transform active:scale-95">
            <i id="micBtnIcon" class="fa-solid fa-microphone text-lg"></i>
            <span id="micBtnLabel">Tap to Speak</span>
          </button>

          <!-- Interrupt / Replay Nova Button -->
          <button id="btnInterruptOrReplay" class="px-3.5 py-2.5 rounded-2xl bg-slate-800/90 hover:bg-slate-700/90 text-cyan-300 border border-slate-700/80 text-xs font-semibold transition flex items-center gap-1.5 shadow" title="Replay Nova's last response or interrupt her">
            <i id="interruptIcon" class="fa-solid fa-rotate-left"></i>
            <span id="interruptLabel" class="hidden sm:inline">Replay Voice</span>
          </button>

        </div>

        <!-- Text Input Fallback & Quick Send (Works on all browsers or quiet environments) -->
        <form id="textFallbackForm" class="flex items-center gap-2 bg-slate-900/90 border border-slate-800 focus-within:border-indigo-500/70 rounded-2xl px-3 py-1.5 transition">
          <i class="fa-regular fa-keyboard text-slate-400 text-sm pl-1"></i>
          <input
            id="textFallbackInput"
            type="text"
             autocomplete="off"
            placeholder="Or type your response here (press Enter to send)..."
            class="flex-1 bg-transparent text-xs sm:text-sm text-white placeholder-slate-400 focus:outline-none py-1.5"
          />
          <button type="submit" id="btnSendText" class="px-3.5 py-1.5 rounded-xl bg-indigo-600/90 hover:bg-indigo-500 text-white text-xs font-semibold transition flex items-center gap-1.5">
            <span>Send</span>
            <i class="fa-solid fa-paper-plane text-[11px]"></i>
          </button>
        </form>

      </div>

    </section>

    <!-- RIGHT COLUMN: REAL-TIME COACHING SIDEBAR, LIVE TRANSCRIPT & SAVED DECK (5 Cols on Desktop) -->
    <aside class="lg:col-span-5 flex flex-col glass-panel rounded-3xl overflow-hidden h-[620px] lg:h-[calc(100vh-92px)]">
      
      <!-- Sidebar Navigation Tabs -->
      <div class="flex items-center justify-between border-b border-slate-800/90 bg-slate-900/60 px-3 pt-2.5">
        <div class="flex items-center gap-1">
          <button data-tab="transcript" class="sidebar-tab active px-3.5 py-2 text-xs font-semibold rounded-t-xl border-b-2 border-indigo-500 text-white bg-slate-800/60 flex items-center gap-1.5 transition">
            <i class="fa-solid fa-Wave-square text-indigo-400"></i>
            <span>Live Call & Coach</span>
          </button>
          <button data-tab="corrections" class="sidebar-tab px-3.5 py-2 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-1.5 transition">
            <i class="fa-solid fa-wand-magic-sparkles text-emerald-400"></i>
            <span>Corrections</span>
            <span id="badgeCorrectionsCount" class="px-1.5 py-0.2 rounded-full text-[10px] bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">0</span>
          </button>
          <button data-tab="saved" class="sidebar-tab px-3.5 py-2 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-1.5 transition">
            <i class="fa-solid fa-bookmark text-amber-400"></i>
            <span>Saved Deck</span>
            <span id="badgeSavedCount" class="px-1.5 py-0.2 rounded-full text-[10px] bg-amber-500/20 text-amber-300 border border-amber-500/30">0</span>
          </button>
        </div>

        <button id="btnClearSession" class="text-[11px] text-slate-400 hover:text-rose-400 px-2 py-1 rounded transition" title="Reset current conversation">
          <i class="fa-solid fa-rotate-right mr-1"></i>Reset
        </button>
      </div>

      <!-- TAB 1: LIVE TRANSCRIPT & INLINE GRAMMAR COACH CARDS -->
      <div id="tabPanelTranscript" class="flex-1 overflow-y-auto p-3 sm:p-4 space-y-4">
        <!-- Dynamic conversation messages & inline coaching cards are rendered here -->
      </div>

      <!-- TAB 2: DEDICATED GRAMMAR & VOCABULARY CORRECTIONS FEED -->
      <div id="tabPanelCorrections" class="hidden flex-1 overflow-y-auto p-3 sm:p-4 space-y-3">
        <div id="correctionsEmptyState" class="h-full flex flex-col items-center justify-center text-center p-6 text-slate-400">
          <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 mb-3">
            <i class="fa-solid fa-check-double text-xl"></i>
          </div>
          <p class="text-sm font-semibold text-slate-200">No Grammar Corrections Yet</p>
          <p class="text-xs text-slate-400 mt-1 max-w-xs">
            Start speaking with Nova! Every time she spots a way to make your English sound more natural or native, a detailed coaching card will appear here.
          </p>
        </div>
        <div id="correctionsListContainer" class="space-y-3"></div>
      </div>

      <!-- TAB 3: SAVED PHRASES & VOCABULARY FLASHCARD DECK -->
      <div id="tabPanelSaved" class="hidden flex-1 overflow-y-auto p-3 sm:p-4 space-y-3">
        <div id="savedEmptyState" class="h-full flex flex-col items-center justify-center text-center p-6 text-slate-400">
          <div class="w-12 h-12 rounded-2xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 mb-3">
            <i class="fa-regular fa-bookmark text-xl"></i>
          </div>
          <p class="text-sm font-semibold text-slate-200">Your Phrase Deck is Empty</p>
          <p class="text-xs text-slate-400 mt-1 max-w-xs">
            Bookmark any improved sentence or vocabulary upgrade during your conversation to build your personal revision deck.
          </p>
        </div>
        <div id="savedListContainer" class="space-y-3"></div>
      </div>

    </aside>

  </main>

  <!-- VOICE & AUDIO SETTINGS MODAL -->
  <div id="modalSettings" class="fixed inset-0 z-50 hidden bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="glass-panel rounded-3xl max-w-md w-full p-6 border border-slate-700/80 shadow-2xl space-y-5">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-indigo-500/20 border border-indigo-500/40 flex items-center justify-center text-indigo-400">
            <i class="fa-solid fa-sliders"></i>
          </div>
          <h2 class="font-display font-bold text-lg text-white">Nova Voice & Call Settings</h2>
        </div>
        <button id="btnCloseSettings" class="text-slate-400 hover:text-white p-1">
          <i class="fa-solid fa-xmark text-lg"></i>
        </button>
      </div>

      <div class="space-y-4 text-xs sm:text-sm">
        <!-- Voice Engine Selection -->
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5">Voice Synthesis Engine</label>
          <select id="selectTtsEngine" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2.5 text-white focus:outline-none focus:border-indigo-500">
            <option value="browser">Instant Browser Neural Voice (Zero Latency)</option>
            <option value="gemini">Gemini 2.5 Native Neural Voice (Aoede HD)</option>
          </select>
        </div>

        <!-- Browser Voice Selection -->
        <div id="browserVoicePickerRow">
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5">Browser English Voice</label>
          <select id="selectVoiceList" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2.5 text-white focus:outline-none focus:border-indigo-500">
            <option value="">Loading available voices...</option>
          </select>
        </div>

        <!-- Speaking Speed -->
        <div>
          <div class="flex justify-between text-xs mb-1">
            <span class="font-semibold uppercase tracking-wider text-slate-400">Speaking Speed</span>
            <span id="speedValueLabel" class="font-mono font-bold text-indigo-400">1.0x (Natural)</span>
          </div>
          <input id="rangeSpeechRate" type="range" min="0.75" max="1.25" step="0.05" value="1.0" class="w-full accent-indigo-500 cursor-pointer" />
          <div class="flex justify-between text-[11px] text-slate-500 mt-0.5">
            <span>0.75x (Slower)</span>
            <span>1.0x (Normal)</span>
            <span>1.25x (Faster)</span>
          </div>
        </div>

        <!-- Auto-Speak Toggle -->
        <div class="flex items-center justify-between pt-2 border-t border-slate-800">
